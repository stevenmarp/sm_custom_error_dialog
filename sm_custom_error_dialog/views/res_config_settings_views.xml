<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sm.custom.error.dialog</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Error Dialogs" name="sm_custom_error_dialog"
                     logo="/sm_custom_error_dialog/static/description/icon.png">
                    <block title="Custom Error Dialog Titles" name="sm_ed_block">
                        <setting string="Enable custom titles"
                                 help="Replace the default Odoo error popup titles with your own wording.">
                            <field name="sm_ed_enabled"/>
                        </setting>
                        <setting string="Global title" invisible="not sm_ed_enabled"
                                 help="Applied to every error dialog. Per-type titles below override it.">
                            <field name="sm_ed_global_title" placeholder="e.g. Please review your data before proceeding"/>
                        </setting>
                        <setting string="Validation Error title" invisible="not sm_ed_enabled">
                            <field name="sm_ed_validation_title" placeholder="Shown for validation errors"/>
                        </setting>
                        <setting string="Access Error title" invisible="not sm_ed_enabled">
                            <field name="sm_ed_access_title" placeholder="Shown for access-rule errors"/>
                        </setting>
                        <setting string="User Error title" invisible="not sm_ed_enabled">
                            <field name="sm_ed_user_title" placeholder="Shown for invalid operation errors"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
